  "layout": {
    "container": ".gtco-container max-width 1140px, padding 0 15px, centered",
    "grid": "Bootstrap v3.3.5 grid: .row + .col-xs/sm/md/lg-*, e.g. col-md-8 col-md-offset-2 heading, col-md-4 footer/widgets, col-sm-2/col-xs-12 logo + col-xs-10 menu",
    "nav": ".gtco-nav padding 30px 0 (10px mobile + 1px solid #666666 bottom border), z-index 1001, hidden menu-1/menu-2 under 768px -> offcanvas #gtco-offcanvas 270px black bg",
    "hero_carousel": "Owl Carousel 2 .owl-carousel-fullwidth, .item > a + img + .slider-copy h2 (24px, weight 100, white, bottom gradient shadow inset rgba(0,0,0,0.75)), dots #CCCCCC inactive / #4D4D4D active, nav arrows rgba(0,0,0,0.7) bg white icon",
    "sections": ".gtco-section padding 3em 0, .gtco-gray #F6F6F6 variant, #gtco-portfolio #303841 dark slate (unused on index), .gto-features top border 1px #E6E6E6",
    "footer": "#gtco-footer #262626 bg, .gtco-copyright #1A1A1A bar, padding 7em 0",
    "buttons_style": "square 0px radius, 2px solid variants, shadow 0 5px 10px rgba(0,0,0,0.15), uppercase Montserrat 700",
    "forms": ".form-control 54px height, 18px light 300, 2px rgba(0,0,0,0.1) border, focus #52D681",
    "animations": "Animate.css + .animate-box opacity 0 (JS reveal), .gototop 50x50 rgba(0,0,0,0.5) rounded 4px"
  },
