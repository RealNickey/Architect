{
  "source": {
    "site": "https://www.gtarchitects.in/",
    "css": [
      "https://www.gtarchitects.in/css/style.css",
      "https://www.gtarchitects.in/css/bootstrap.css",
      "https://www.gtarchitects.in/css/animate.css",
      "https://www.gtarchitects.in/css/icomoon.css",
      "https://www.gtarchitects.in/css/themify-icons.css",
      "https://www.gtarchitects.in/css/owl.carousel.min.css",
      "https://www.gtarchitects.in/css/owl.theme.default.min.css"
    ],
    "google_fonts": "https://fonts.googleapis.com/css?family=Merriweather:300,400|Montserrat:400,700",
    "template": "Aesthetic by freehtml5.co (FH5CO)",
    "logo": "images/logo2.jpg (<div id=\"gtco-logo\"><a><img src=\"images/logo2.jpg\">)",
    "notes": "Did NOT download images per task. Bootstrap v3.3.5 + Owl Carousel 2 + Animate.css (Daniel Eden) + icomoon + themify-icons."
  },
  "google_fonts_detail": {
    "Merriweather": {
      "weights": [
        300,
        400
      ],
      "usage": "body serif, paragraphs"
    },
    "Montserrat": {
      "weights": [
        400,
        700
      ],
      "usage": "headings h1-h6, nav, buttons, footer links, labels"
    }
  },
  "typography": {
    "body": {
      "font_family": "\"Merriweather\", serif",
      "weight": 400,
      "size": "14px",
      "line_height": "1.7",
      "color": "#777777"
    },
    "headings_all": {
      "selector": "h1,h2,h3,h4,h5,h6,figure",
      "font_family": "\"Montserrat\", sans-serif",
      "weight": 400,
      "color": "#000000",
      "margin": "0 0 20px 0"
    },
    "nav_logo": {
      "selector": ".gtco-nav #gtco-logo",
      "size": "20px",
      "transform": "uppercase",
      "weight": "bold"
    },
    "nav_links": {
      "selector": ".gtco-nav ul li a",
      "family": "\"Montserrat\", sans-serif",
      "size": "13px !important (uppercase, letter-spacing .05em)",
      "base_color": "#CCCCCC",
      "hover_active": "#000000"
    },
    "section_heading": {
      "selector": ".gtco-heading h2",
      "size": "40px",
      "line_height": "1.5",
      "color": "#4D4D4D",
      "weight": 300
    },
    "section_paragraph": {
      "selector": ".gtco-heading p",
      "size": "18px",
      "line_height": "1.7",
      "color": "#898989"
    },
    "hero_h1": {
      "selector": "#gtco-header h1 / .display-tc h1",
      "size": "50px desktop / 59px cover, 34px mobile",
      "weight": 100,
      "color": "#D3F1ED (header) / #FFFFFF (cover)"
    },
    "hero_p": {
      "selector": "#gtco-header p",
      "size": "20px",
      "color": "#D3F1ED"
    },
    "buttons": {
      "selector": ".btn",
      "family": "\"Montserrat\", sans-serif",
      "size": "13px",
      "weight": 700,
      "letter_spacing": "2px",
      "transform": "uppercase",
      "padding": "20px 30px",
      "radius": "0px (square)"
    },
    "footer_h3": {
      "selector": "#gtco-footer h3",
      "color": "#FFFFFF",
      "size": "default h3, CTA 30px weight 300"
    },
    "footer_links": {
      "selector": "#gtco-footer .gtco-list-link li a",
      "transform": "uppercase",
      "size": "13px !important",
      "family": "\"Montserrat\", sans-serif"
    }
  },
